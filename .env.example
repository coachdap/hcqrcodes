# ---------------------------------------------------------------------------
# qrgen configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------

# Port the Express app listens on inside the container. Leave at 3000 so that
# internal callers can use the documented http://qrgen:3000 address.
PORT=3000

# Interface to bind. 0.0.0.0 is required for container networking.
HOST=0.0.0.0

# Host port published on hc-new, bound to 127.0.0.1 only. Apache proxies
# qr.hoopscollege.com to this. 3020 is free on hc-new; 3000/3001/3010/3011/3031
# are already taken.
QRGEN_HOST_PORT=3020

# --- Authentication -------------------------------------------------------

# Bearer token required for requests arriving through the public proxy.
# Generate with:  openssl rand -hex 32
# If this is unset, external requests are refused with 503 rather than allowed.
QRGEN_TOKEN=

# When true (default), requests that did NOT traverse the public proxy — no
# X-Forwarded-For header and an RFC1918 source address — skip the token check.
# This is what lets Hyperframes and n8n call qrgen:3000 directly.
# Set to false to require the bearer token from every caller, internal included.
QRGEN_TRUST_INTERNAL=true

# --- Rate limiting --------------------------------------------------------

# Sliding window applied to the generation endpoints only (/health and / are
# never limited). Runs BEFORE the token check, so unauthenticated floods are
# shed cheaply rather than after TLS and body parsing are already paid for.
#
# Cost is weighted: one unit per QR, so a 50-item batch costs 50. Keep the limit
# above MAX_BATCH_ITEMS (200) or a full-size batch can never succeed.
QRGEN_RATE_WINDOW_MS=60000
QRGEN_RATE_LIMIT=300
QRGEN_RATE_LIMIT_INTERNAL=1200

# Distinct callers tracked before the oldest entries are evicted.
QRGEN_RATE_MAX_KEYS=10000

# --- Generation -----------------------------------------------------------

# Directory that HTTP callers may reference by file path in the `logo` field.
# Anything outside it is rejected; base64 logos are always accepted. The CLI is
# not subject to this restriction.
QRGEN_LOGO_DIR=/output/logos

# Max JSON body size. Raise if you post large base64 logos.
QRGEN_BODY_LIMIT=10mb

# --- Container resource ceiling (docker-compose) ---------------------------

# A single 8192px PNG render peaks near 560MB inside sharp. These cap the
# container so a burst of large renders cannot starve n8n or the live sites
# sharing this host; the container is OOM-killed and restarted instead.
QRGEN_MEM_LIMIT=1536m
QRGEN_CPUS=1.5

# Where the acceptance script writes its samples.
OUTPUT_DIR=/output

# --- Client (client.js — set these on the CALLING service) -----------------

# Internal callers on hc-internal:
#   QRGEN_URL=http://qrgen:3000        (no token needed)
# External callers:
#   QRGEN_URL=https://qr.hoopscollege.com
#   QRGEN_TOKEN=<same token as above>
QRGEN_URL=http://qrgen:3000

# Client-side request timeout in milliseconds.
QRGEN_TIMEOUT_MS=15000
