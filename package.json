{
  "name": "qrgen",
  "version": "1.0.0",
  "description": "Print-ready and web-ready QR code generation for Hoops College and Chase Excellence",
  "type": "module",
  "main": "src/core.js",
  "exports": {
    ".": "./src/core.js",
    "./client": "./client.js"
  },
  "bin": {
    "qrgen": "./bin/qrgen.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src --watch-path=public src/server.js",
    "test": "node test/generate-all.js && node test/convert-svg.js && node test/tools.js",
    "test:convert": "node test/convert-svg.js",
    "test:tools": "node test/tools.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "archiver": "^7.0.1",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.2",
    "zod": "^3.24.1"
  },
  "private": true
}
